<?xml version="1.0" encoding="utf-8"?>
<!--
  FirstBase — For Internal Use Only
  WIN-INSTALL variant: RunSynchronous (SetupComplete.cmd invocation) removed.
  Used by NoPayload (-NoPayload) builds where setup.exe drives the full install
  and no post-install Windows Update loop or FirstBase automation is staged.

  Offline copy to %WINDIR%\Panther\unattend.xml during WinPE apply (Deploy\TechInstall.cmd)
  or passed directly to setup.exe via /unattend:D:\Autounattend.xml from startnet.cmd.
  Scope: unattended installation only — no Audit Mode handoff, no update scripts.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <!--
    specialize pass: RunSynchronous block intentionally omitted.
    The full autounattend.xml invokes SetupComplete.cmd here to arm Audit Mode
    auto-logon and start the Windows Update loop. For WIN-INSTALL builds there
    is no SetupComplete.cmd on disk, so that block is not included.
  -->
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>false</HideLocalAccountScreen>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>false</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
    </component>
  </settings>
</unattend>
